{
  "name": "free-dsh-search",
  "version": "2.0.0",
  "description": "Free-tier web search providers (Tavily, Serper, Exa, Firecrawl, LangSearch) for DeepSeek Harness, with priority-based fallback.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wuyueyu-ovo/free-dsh-search.git"
  },
  "homepage": "https://github.com/Wuyueyu-ovo/free-dsh-search#readme",
  "bugs": {
    "url": "https://github.com/Wuyueyu-ovo/free-dsh-search/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "tavily",
    "serper",
    "exa",
    "firecrawl",
    "langsearch"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
